# Django 基础配置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 安全配置
# CORS — 前端地址，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF 信任来源
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HSTS — 生产环境建议启用
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
# SECURE_SSL_REDIRECT 配合 SECURE_PROXY_SSL_HEADER 使用
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# 数据库配置
DB_NAME=internship_db
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# RAG 知识库配置（使用阿里云百炼平台）
# 注册地址: https://bailian.console.aliyun.com/
# 同一个 API Key 同时用于 LLM 问答和文档向量化
DEEPSEEK_API_KEY=sk-你的百炼API-Key
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_CHAT_MODEL=qwen-turbo
DASHSCOPE_API_KEY=sk-你的百炼API-Key
CHROMA_PERSIST_DIR=
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_FILE_SIZE_MB=20

# 文件上传
# MAX_UPLOAD_SIZE=20971520  # 20MB