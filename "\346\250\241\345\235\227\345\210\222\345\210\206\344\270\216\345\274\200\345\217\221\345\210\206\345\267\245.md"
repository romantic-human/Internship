│              │              │              │
├─ M1 认证 ────┤              │              │
│              ├─ M2 菜单 ────┤              │
│              ├─ M4 部门 ────┤              │
│              │              ├─ M3 权限 ────┤
│              │              ├─ M5 角色 ────┤
│              │              │              ├─ M6 用户管理 ─┤
│              │              ├─ M7 日志 ────┤              │
│              │              ├─ M8 配置 ────┤              │
